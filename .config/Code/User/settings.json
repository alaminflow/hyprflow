{
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "editor.fontSize": 15,
  "editor.formatOnSave": true,
  "files.autoSave": "onFocusChange",
  "editor.fontFamily": "'JetBrainsMono Nerd Font', Consolas",
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', Consolas",
  "terminal.integrated.fontSize": 14,
  "editor.wordWrap": "on",
  "python.analysis.typeCheckingMode": "standard",
  "workbench.colorTheme": "One Dark Pro Night Flat",
  "github.copilot.chat.copilotDebugCommand.enabled": false,
  "github.copilot.chat.tools.viewImage.enabled": false,
  "github.copilot.chat.gemini35FlashReducedToolUsePrompt.enabled": false,
  "github.copilot.chat.exploreAgent.enabled": false,
  "github.copilot.chat.gpt55GetChangedFilesTool.enabled": false,
  "github.copilot.chat.gpt55ReadFileTool.enabled": false,
  "github.copilot.chat.gpt56Verbosity.enabled": false,
  "github.copilot.chat.languageContext.typescript.enabled": false,
  "python.autoComplete.extraPaths": [],
  // 1. Turn off IntelliSense popups & auto-completions
  "editor.suggestOnTriggerCharacters": false,
  "editor.tabCompletion": "on",
  "editor.wordBasedSuggestions": "offWithInlineSuggestions",
  "editor.parameterHints.enabled": false,
  // 2. Turn off AI / ghost-text completions (Copilot / Inline Suggestions)
  "editor.inlineSuggest.enabled": false,
  // 3. Turn off automatic comment behaviors
  "editor.autoClosingComments": "always",
  "editor.autoClosingQuotes": "always",
  "workbench.settings.applyToAllProfiles": [],
  "[cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
  },
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
  },
  "chat.titleBar.openInAgentsWindow.enabled": false,
  "workbench.browser.showInTitleBar": true,
  "workbench.editor.enablePreview": false,
  "workbench.editor.showTabs": "none",
  "window.density.layout": "compact",
  "js/ts.experimental.useTsgo": true,
  "workbench.activityBar.compact": true,
  "workbench.layoutControl.enabled": false,
  "workbench.sideBar.location": "right",
  "workbench.activityBar.location": "hidden",
  "workbench.panel.showLabels": false,
  "editor.minimap.enabled": false,
  "workbench.editor.editorActionsLocation": "hidden",
  "workbench.navigationControl.enabled": false,
  "window.commandCenter": false,
  "window.menuBarVisibility": "compact",
}
