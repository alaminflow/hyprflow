# DO NOT EDIT! This file is managed by nwg-look and dotfiles.
# Any user customization should be done in ~/.gtkrc-2.0.mine instead.

include "~/.gtkrc-2.0.mine"
gtk-theme-name="Tokyonight-Dark"
gtk-icon-theme-name="Tokyonight-Moon"
gtk-font-name="JetBrainsMono Nerd Font Medium 11"
gtk-cursor-theme-name="Bibata-Modern-Classic"
gtk-cursor-theme-size=20
gtk-toolbar-style=GTK_TOOLBAR_ICONS
gtk-toolbar-icon-size=GTK_ICON_SIZE_LARGE_TOOLBAR
gtk-button-images=0
gtk-menu-images=1
gtk-sound-theme-name="freedesktop"
gtk-enable-event-sounds=0
gtk-enable-input-feedback-sounds=0
gtk-error-bell=1
gtk-xft-antialias=1
gtk-xft-hinting=1
gtk-xft-hintstyle="hintslight"
gtk-xft-rgba="rgb"
